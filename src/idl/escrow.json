      "name": "EscrowAccount",
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "sender", "type": "publicKey" },
          { "name": "receiver", "type": "publicKey" },
          { "name": "amount", "type": "u64" },
          { "name": "released", "type": "bool" },
          { "name": "escrowId", "type": "u64" }
