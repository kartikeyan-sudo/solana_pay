        { "name": "escrowAccount", "isMut": true, "isSigner": false },
        { "name": "sender", "isMut": true, "isSigner": true },
        { "name": "receiver", "isMut": true, "isSigner": false }
      ],
      "args": []
    }
  ],
  "accounts": [
